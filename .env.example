# Django Settings
# APP_ENV must be one of: localdev | testing | production. Anything else
# (including blank) now fails at startup instead of silently using dev settings.
SECRET_KEY=your-production-secret-key-min-50-chars
APP_ENV=production
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# Reject request bodies larger than this many bytes (default 50 MB). Bulk
# student imports (workbook + photo ZIP) are the largest legitimate payloads.
MAX_REQUEST_BODY_SIZE=52428800

# Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=skuumate_db
DB_USER=skuumate_user
DB_PASSWORD=your-strong-db-password
DB_ROOT_PASSWORD=your-strong-root-password
DB_CONN_MAX_AGE=60

# CORS Settings
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Email Configuration (SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=SkuuMate <noreply@yourdomain.com>

# Frontend URL (for password reset links, etc.)
FRONTEND_URL=https://yourdomain.com

# Payments (Paystack)
# INTEGRATION_MODE=live enables the real providers; "simulate" (the default)
# uses the built-in simulated gateway for development.
INTEGRATION_MODE=live
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key
PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key

# SMS (system-wide sender used when a school has no active SMS provider)
# SMS_PROVIDER one of: arkesel | mnotify | twilio | africas_talking | simulate
SMS_PROVIDER=arkesel
ARKESEL_API_KEY=
ARKESEL_SENDER=SKUUMATE
MNOTIFY_API_KEY=
MNOTIFY_SENDER_ID=SKUUMATE

# SSL / Security
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
# cPanel/Passenger terminates TLS and forwards plain HTTP. Keep True behind a
# proxy that sets X-Forwarded-Proto so SECURE_SSL_REDIRECT does not loop.
USE_X_FORWARDED_PROTO=True

# Gunicorn
GUNICORN_WORKERS=3
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120
